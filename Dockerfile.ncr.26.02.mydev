# =============================================================================
# Dockerfile: verl Moonlight Training on B300 — dev image
# =============================================================================
# Builds on top of the stable base image (Dockerfile.base) which contains
# vLLM, CUDA extensions, and system deps. Only the frequently-changed layers
# are here: verl code, Gym code, and Gym venvs.
#
# Rebuild this whenever verl or Gym code changes (~10-15 min, no CUDA compile).
# Rebuild Dockerfile.base only when vLLM/CUDA/system packages change (~30 min).
#
# Build:
#   DOCKER_BUILDKIT=0 docker build -f Dockerfile.ncr.26.02.mydev \
#     --network host \
#     -t registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.dev .
#   # Re-tag for docker-compose (uses local name):
#   docker tag registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.dev \
#              myverl:ncr2602_vllm012.dev
#   dvoff && docker push registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.dev
# =============================================================================
FROM registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.base

# ── Layer 10-11: Copy codebases (LAST — these change most often) ─────────────
#   verifiable-instructions no longer COPYed — Gym lc_fix branch pulls it
#   from git+https://github.com/spacegoing/my_verifiable-instructions.git
#   (see plan_uv_gym_integration.md, instruction_following/requirements.txt).
COPY verl /root/myCodeLab/host/verl/
COPY Gym /root/myCodeLab/host/Gym/

# ── Layer 12: Install verl (editable, into /opt/venv/) ───────────────────────
#   verl stays in the system venv for training loop access.
RUN cd /root/myCodeLab/host/verl && uv pip install --no-build-isolation --no-deps -e .

# ── Layer 13: Gym isolated venv + ng_run per-server venvs ────────────────────
#   Architecture (design_manual.md §3-5, README Dockerfile Guide §141-178):
#     1. Upgrade uv: Gym requires >=0.9.30, base has 0.7.2
#        (plan_uv_gym_integration.md). Installed to ~/.local/bin/.
#     2. Gym main venv: /opt/gym_venvs/main/ — NOT under the docker-compose
#        mount (/root/myCodeLab/host/). Venvs at /opt/ survive the mount and
#        live on fast node-local disk, not the PFS (quarkfs).
#        (see plans/nemo_gym_worker/dockerfile_decouple_uv_venv.md)
#     3. ng_run "+dry_run=true" "+uv_venv_dir=/opt/gym_venvs": creates 7
#        per-server venvs under /opt/gym_venvs/resources_servers/*/.venv/
#        (also survives mount, fast disk). Serial to minimize uv cache bloat.
#     4. env.yaml: satisfies ${policy_base_url} etc. interpolation for
#        policy_model placeholder (gym_env.yaml, design_manual.md §8).
#     5. lcb_integration symlink: code_gen @ray.remote workers spawn on
#        system Python, need lcb_integration importable (README §167-169).
#   lc_fix branch: verifiable-instructions pulled from git by ng_run
#   (no local COPY needed — see plan_uv_gym_integration.md).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    cd /root/myCodeLab/host/Gym && \
    mkdir -p cache && \
    /root/.local/bin/uv venv --python 3.12 /opt/gym_venvs/main && \
    /root/.local/bin/uv pip install -e ".[dev]" --python /opt/gym_venvs/main/bin/python && \
    /root/.local/bin/uv pip install \
        langdetect openapi_schema_validator math_verify \
        absl-py nltk immutabledict \
        --python /opt/gym_venvs/main/bin/python && \
    cp /root/myCodeLab/host/verl/my_scripts/gym_env.yaml \
       /root/myCodeLab/host/Gym/env.yaml && \
    /opt/gym_venvs/main/bin/ng_run \
        "+config_paths=[/root/myCodeLab/host/verl/my_scripts/gym_blend_servers.yaml]" \
        "+dry_run=true" \
        "+uv_venv_dir=/opt/gym_venvs" && \
    ln -sf /root/myCodeLab/host/Gym/resources_servers/code_gen/lcb_integration \
        /usr/local/lib/python3.12/dist-packages/lcb_integration

# ── Layer 14-15: Final ───────────────────────────────────────────────────────
WORKDIR /root/myCodeLab
CMD ["/bin/bash"]

# Total new layers above base: 6 (2 RUN + 2 COPY + 1 WORKDIR + 1 CMD + 1 FROM)
# Base has ~122 layers; adding 6 = ~128. If near limit, merge COPY layers.
