# FROM nvcr.io/nvidia/nemo:25.11.01
FROM nvcr.io/nvidia/nemo:26.02

# ============================================================
# "DO NOT TOUCH" packages from 26.02 base image:
#   torch=2.10.0a0  torchvision=0.25.0a0  pytorch-triton=3.5.0
#   flash_attn=2.7.4.post1+25.11  flashinfer=0.5.3
#   transformer_engine=2.12.0  deep_ep=1.2.1  nvfuser=0.2.34
#   torchao=0.14.0  torch_tensorrt=2.10.0a0  tensorrt=10.14.1.48
#   nvidia-modelopt=0.37.0  nvidia-resiliency-ext=0.4.1+cuda13
#   numpy=1.26.4  cuda-bindings=13.1.1  cuda-python=13.1.1
#   apex=0.1  cupy-cuda12x=14.0.1  compressed-tensors=0.13.0
# ============================================================

# 1. Set up workspace directories and symlinks
RUN git config --global --add safe.directory '*'
RUN mkdir -p /root/myCodeLab && \
    ln -s /public /root/myCodeLab/public && \
    ln -s /public/lichang93/stCodeLab /root/myCodeLab/host

# 2. Install your project's Python dependencies
RUN pip config set global.index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

# 3. Install wandb (not in 26.02 base) then log in
RUN pip install --no-cache-dir --no-deps wandb
RUN wandb login df3cecbfc0874c8a352c40820becf4a15575614e

# 4. Install Dev Deps
RUN apt-get update && apt-get install pdsh tmux htop vim -y

RUN pip install --no-cache-dir --no-deps gpustat codetiming tensordict mathruler pylatexenc torchdata

# 5. Packages removed from 26.02 that we need
#    xformers: needs source build for torch 2.10, install from NVIDIA's build or skip
#    hydra-core, grouped_gemm, bitsandbytes, mamba_ssm, causal_conv1d
RUN pip install --no-cache-dir --no-deps hydra-core omegaconf
RUN pip install --no-cache-dir --no-deps grouped_gemm bitsandbytes
RUN pip install --no-cache-dir --no-deps causal_conv1d mamba_ssm

# 6. Update transformers to 4.57.3 (26.02 ships 4.56.0)
RUN pip install --no-cache-dir --no-deps transformers==4.57.3

# 7. VLLM 0.12.0 — uninstall base vLLM 0.14.2 (no /opt/vllm in 26.02)
RUN pip uninstall -y vllm && \
    pip install setuptools_scm
COPY vllm /opt/vllm
RUN cd /opt/vllm && \
    MAX_JOBS=64 NVCC_THREADS=1 pip install --no-deps --no-build-isolation --no-cache-dir -e .
RUN pip install --no-cache-dir --no-deps model_hosting_container_standards anthropic

# 8. Other deps
COPY mbridge /root/myCodeLab/host/mbridge/
RUN cd /root/myCodeLab/host/mbridge/ && \
    pip3 install --no-cache-dir --no-deps . && \
    cd .. && rm -rf mbridge

# 9. Set Environment Variables (Grouped)
ENV NLTK_DATA=/usr/local/share/nltk_data \
    TIKTOKEN_ENCODINGS_BASE=/root/tiktoken_cache

# 10. Copy small config files to a temp folder (Saves layers)
COPY o200k_base.tiktoken to_append.sh .tmux.conf /tmp/docker_context/

# 11. Copy your local NLTK data
COPY nltk_data /usr/local/share/nltk_data

# 12. Copy Codebases
COPY verl /root/myCodeLab/host/verl/
COPY MJ_NEMO_GYM /root/myCodeLab/host/mjnemogym/

# 13. MEGA RUN: Installs everything in one single layer
RUN \
    # --- A. Setup Configs & Tiktoken (Move from temp) ---
    mkdir -p /root/tiktoken_cache && \
    mv /tmp/docker_context/o200k_base.tiktoken /root/tiktoken_cache/ && \
    echo "" >> /root/.bashrc && \
    cat /tmp/docker_context/to_append.sh >> /root/.bashrc && \
    mv /tmp/docker_context/.tmux.conf /root/ && \
    rm -rf /tmp/docker_context && \
    # --- B. Install Verl ---
    cd /root/myCodeLab/host/verl && \
    pip3 install --no-deps -e . && \
    # --- C. Install MJ NemoGym (--no-deps to protect base packages) ---
    ln -s /usr/local/lib/python3.12/dist-packages /root/myCodeLab/dist-packages && \
    cd /root/myCodeLab/host/mjnemogym && \
    pip3 install --no-cache-dir --no-deps -e .

# Set the final working directory and default command
WORKDIR /root/myCodeLab
CMD ["/bin/bash"]

# Missing deps (add here if runtime errors reveal missing packages)
# RUN pip install --no-cache-dir --no-deps <package>

# Build:
# DOCKER_BUILDKIT=0 docker build -f Dockerfile.ncr.26.02.mydev --provenance=false --network host -t registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.dev .
# Run:
# docker run --entrypoint /bin/bash -itd -v /mnt/public:/public --name vrl --network host registry.cn-hangzhou.aliyuncs.com/spacegoing/myverl:ncr2602_vllm012.dev
